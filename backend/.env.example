# Copy thành backend/.env và đặt giá trị riêng, không commit file .env thật.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=football_app
DB_PASSWORD=replace-with-the-root-env-DB_PASSWORD
DB_NAME=football_management
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
# Chỉ dùng cho demo. Chuyển thành false trước khi triển khai thật.
DEMO_PAYMENTS_ENABLED=true
BANK_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_ADMIN_PASSWORD=replace-admin-password
SEED_MANAGER_PASSWORD=replace-manager-password
SEED_RECEPTIONIST_PASSWORD=replace-reception-password
SEED_ACCOUNTANT_PASSWORD=replace-accountant-password
